{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 0, 0, 0.65)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Workers vivants",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"expr": "up{job=\"spark-workers\"}", "legendFormat": "{{instance}}", "refId": "A"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "graphMode": "area", "colorMode": "background", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "Applications en cours",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "targets": [
        {"expr": "spark_master_apps_running", "legendFormat": "running", "refId": "A"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "graphMode": "area", "colorMode": "background", "justifyMode": "center"}
    },
    {
      "type": "timeseries",
      "title": "CPU par conteneur",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "rate(container_cpu_usage_seconds_total[1m]) * 100", "legendFormat": "{{name}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "type": "timeseries",
      "title": "Mémoire par conteneur",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "container_memory_working_set_bytes", "legendFormat": "{{name}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "type": "timeseries",
      "title": "Réseau des workers",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "rate(container_network_receive_bytes_total[1m])", "legendFormat": "rx {{name}}", "refId": "A"},
        {"expr": "rate(container_network_transmit_bytes_total[1m])", "legendFormat": "tx {{name}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "Spark Observability",
  "version": 1
}
